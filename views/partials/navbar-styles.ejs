<style>
    /* Top bar — limpio / corporativo */
    .navbar-crm {
        background: #ffffff !important;
        border-bottom: 1px solid var(--farmadescaso-border, #e2e8e4);
        box-shadow: 0 1px 2px rgba(26, 46, 34, 0.04);
        padding-top: 0.35rem;
        padding-bottom: 0.35rem;
        font-family: var(--farmadescaso-font, 'DM Sans', system-ui, sans-serif);
    }

    .navbar-crm .navbar-brand {
        padding: 0.2rem 0.4rem;
        margin-right: 0.75rem;
    }

    .navbar-logo {
        height: 36px;
        width: auto;
        display: block;
        transition: opacity 0.2s ease;
    }

    .logo-brand {
        display: flex;
        align-items: center;
    }

    .logo-brand:hover .navbar-logo {
        opacity: 0.85;
    }

    .navbar-side-toggle {
        color: var(--farmadescaso-text-primary, #1a2e22) !important;
        text-decoration: none;
        padding: 0.25rem 0.5rem;
        line-height: 1;
    }

    .navbar-side-toggle:hover,
    .navbar-side-toggle:focus {
        color: var(--farmadescaso-primary, #0b891b) !important;
    }

    .navbar-crm .navbar-toggler {
        border: 1px solid var(--farmadescaso-border, #e2e8e4);
        padding: 0.35rem 0.5rem;
        box-shadow: none;
    }

    .navbar-crm .navbar-toggler:focus {
        box-shadow: 0 0 0 0.15rem rgba(11, 137, 27, 0.2);
    }

    .navbar-crm .navbar-nav .nav-link {
        color: var(--farmadescaso-text-secondary, #64748b);
        font-weight: 500;
        font-size: 0.9rem;
        padding: 0.45rem 0.65rem;
        border-radius: 6px;
        transition: background 0.15s ease, color 0.15s ease;
    }

    .navbar-crm .navbar-nav .nav-link i {
        opacity: 0.8;
    }

    .navbar-crm .navbar-nav .nav-link:hover,
    .navbar-crm .navbar-nav .nav-link:focus {
        color: var(--farmadescaso-primary-dark, #096516);
        background: var(--farmadescaso-bg-light, #eef8f0);
    }

    .navbar-crm .navbar-nav .nav-link.active {
        color: var(--farmadescaso-primary-dark, #096516);
        background: var(--farmadescaso-bg-light, #eef8f0);
        font-weight: 600;
    }

    .navbar-crm .dropdown-menu {
        border: 1px solid var(--farmadescaso-border, #e2e8e4);
        border-radius: 8px;
        box-shadow: 0 8px 24px rgba(26, 46, 34, 0.08);
        padding: 0.4rem;
        font-size: 0.9rem;
    }

    .navbar-crm .dropdown-item {
        border-radius: 6px;
        color: var(--farmadescaso-text-primary, #1a2e22);
        padding: 0.45rem 0.75rem;
        font-weight: 500;
    }

    .navbar-crm .dropdown-item:hover,
    .navbar-crm .dropdown-item:focus {
        background: var(--farmadescaso-bg-light, #eef8f0);
        color: var(--farmadescaso-primary-dark, #096516);
    }

    .navbar-crm .dropdown-divider {
        border-color: var(--farmadescaso-border, #e2e8e4);
        margin: 0.35rem 0;
    }

    /* Navbar fija */
    .navbar-fixed {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 1030;
    }

    body {
        padding-top: 56px;
    }

    @media (min-width: 992px) {
        body {
            padding-top: 56px;
        }
    }

    @media (max-width: 991px) {
        .navbar-nav .nav-item .nav-link .d-none-mobile {
            display: none !important;
        }

        .navbar-brand {
            font-size: 1rem;
        }

        .navbar-crm .navbar-nav .nav-link {
            padding: 0.55rem 0.75rem;
            font-size: 0.9rem;
        }

        .navbar-collapse.show .nav-label {
            display: inline !important;
        }

        .navbar-collapse.show .navbar-nav .nav-link i {
            margin-right: 0.35rem !important;
        }

        .navbar-crm .navbar-collapse {
            background: #ffffff;
            margin-top: 0.5rem;
            padding: 0.5rem;
            border: 1px solid var(--farmadescaso-border, #e2e8e4);
            border-radius: 8px;
            max-height: calc(100vh - 60px);
            overflow-y: auto;
            box-shadow: 0 8px 24px rgba(26, 46, 34, 0.08);
        }

        .dropdown-menu {
            max-height: 70vh;
            overflow-y: auto;
            position: fixed !important;
            top: auto !important;
            left: auto !important;
            right: 1rem !important;
            transform: none !important;
        }
    }

    @media (min-width: 768px) and (max-width: 991px) {
        .navbar-crm .navbar-nav .nav-link {
            padding: 0.5rem 0.5rem;
            font-size: 0.85rem;
        }
    }

    /* LG–XL: solo iconos en menú principal */
    @media (min-width: 992px) and (max-width: 1199.98px) {
        .navbar .navbar-nav.me-auto {
            flex-wrap: nowrap;
            overflow-x: auto;
            overflow-y: hidden;
            -webkit-overflow-scrolling: touch;
        }

        .navbar .navbar-nav.me-auto::-webkit-scrollbar {
            height: 4px;
        }

        .navbar .navbar-nav.me-auto::-webkit-scrollbar-thumb {
            background: #c9d4cc;
            border-radius: 999px;
        }

        .navbar .navbar-nav.me-auto .nav-link .nav-label {
            display: none !important;
        }

        .navbar .navbar-nav.me-auto .nav-link i {
            margin-right: 0 !important;
        }

        .navbar .navbar-nav.me-auto .nav-link {
            padding: 0.45rem 0.55rem;
            white-space: nowrap;
        }
    }

    @media (min-width: 768px) {
        .sidebar {
            position: sticky;
            top: 56px;
            height: calc(100vh - 56px);
            overflow-y: auto;
        }
    }

    @media (max-width: 767px) {
        .sidebar {
            position: fixed;
            top: 56px;
            left: -100%;
            width: 250px;
            height: calc(100vh - 56px);
            z-index: 1020;
            transition: left 0.3s ease;
        }

        .sidebar.show {
            left: 0;
        }

        .sidebar-overlay {
            display: none;
            position: fixed;
            top: 56px;
            left: 0;
            right: 0;
            bottom: 0;
            background-color: rgba(26, 46, 34, 0.35);
            z-index: 1019;
        }

        .sidebar-overlay.show {
            display: block;
        }
    }

    .main-content-wrapper {
        margin-top: 0;
    }
</style>
