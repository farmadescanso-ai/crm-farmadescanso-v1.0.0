<script>
    // Manejo del sidebar en móviles + grupos colapsables
    document.addEventListener('DOMContentLoaded', function() {
        const sidebar = document.querySelector('.sidebar');
        if (!sidebar) return;

        try {
            if (typeof bootstrap !== 'undefined' && bootstrap.Tooltip) {
                const tooltipTriggers = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
                tooltipTriggers.forEach((el) => {
                    if (!bootstrap.Tooltip.getInstance(el)) {
                        new bootstrap.Tooltip(el, { trigger: 'hover focus', boundary: 'window' });
                    }
                });
            }
        } catch (_) {}

        // Persistencia de grupos del menú lateral
        (function initNavGroups() {
            const nav = document.getElementById('sidebarNav');
            if (!nav || typeof bootstrap === 'undefined' || !bootstrap.Collapse) return;

            const STORAGE_KEY = 'farmadescaso.sidebarNavGroups';
            const currentGroups = String(nav.getAttribute('data-current-groups') || '')
                .split(',')
                .map((s) => s.trim())
                .filter(Boolean);

            let saved = {};
            try {
                saved = JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}') || {};
            } catch (_) {
                saved = {};
            }

            nav.querySelectorAll('.nav-group').forEach((group) => {
                const key = group.getAttribute('data-nav-group');
                const panel = group.querySelector('.collapse');
                const toggle = group.querySelector('.nav-group-toggle');
                if (!key || !panel || !toggle) return;

                const mustOpen = currentGroups.includes(key);
                const hasSaved = Object.prototype.hasOwnProperty.call(saved, key);
                const defaultOpen = currentGroups.length === 0 && (key === 'ventas' || key === 'cartera');
                const preferOpen = mustOpen || (hasSaved ? saved[key] === true : defaultOpen);
                const preferClosed = !mustOpen && hasSaved && saved[key] === false;

                if (preferOpen && !panel.classList.contains('show')) {
                    panel.classList.add('show');
                    toggle.setAttribute('aria-expanded', 'true');
                } else if (preferClosed && panel.classList.contains('show')) {
                    panel.classList.remove('show');
                    toggle.setAttribute('aria-expanded', 'false');
                }

                panel.addEventListener('shown.bs.collapse', function() {
                    toggle.setAttribute('aria-expanded', 'true');
                    try {
                        const state = JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}') || {};
                        state[key] = true;
                        localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
                    } catch (_) {}
                });
                panel.addEventListener('hidden.bs.collapse', function() {
                    // No cerrar el grupo de la página actual de forma permanente:
                    // el usuario puede contraerlo, pero al volver a la sección se reabre.
                    toggle.setAttribute('aria-expanded', 'false');
                    try {
                        const state = JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}') || {};
                        state[key] = false;
                        localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
                    } catch (_) {}
                });
            });
        })();
        
        const sidebarOverlay = document.createElement('div');
        sidebarOverlay.className = 'sidebar-overlay';
        document.body.appendChild(sidebarOverlay);
        
        function toggleSidebar() {
            if (window.innerWidth <= 767) {
                sidebar.classList.toggle('show');
                sidebarOverlay.classList.toggle('show');
            }
        }
        
        const sidebarToggle = document.getElementById('sidebarToggle');
        if (sidebarToggle) {
            sidebarToggle.addEventListener('click', function(e) {
                e.preventDefault();
                toggleSidebar();
            });
        }
        
        sidebarOverlay.addEventListener('click', function() {
            sidebar.classList.remove('show');
            sidebarOverlay.classList.remove('show');
        });
        
        const sidebarLinks = sidebar.querySelectorAll('a');
        sidebarLinks.forEach(link => {
            link.addEventListener('click', function() {
                if (window.innerWidth <= 767) {
                    sidebar.classList.remove('show');
                    sidebarOverlay.classList.remove('show');
                }
            });
        });
        
        window.addEventListener('resize', function() {
            if (window.innerWidth > 767) {
                sidebar.classList.remove('show');
                sidebarOverlay.classList.remove('show');
            }
        });
    });
</script>
<script src="/js/notifications.js"></script>
<script src="/js/go-to-top.js"></script>
<script>
  // Asegura botón ARRIBA aunque el script se cargue tarde
  (function () {
    function boot() {
      if (!window.ScrollToTopButton) return;
      if (document.querySelector('[data-stt-mounted]')) {
        // Re-aplica estilo ARRIBA si ya existía instancia vacía
        window.ScrollToTopButton.init({ text: 'ARRIBA' });
        return;
      }
      window.ScrollToTopButton.init({ text: 'ARRIBA' });
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', boot);
    } else {
      boot();
    }
  })();
</script>
