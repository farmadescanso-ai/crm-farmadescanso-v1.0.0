<%#
  Menú lateral — fuente de verdad, agrupado y colapsable por secciones.
  Requiere res.locals.esAdmin (attachLocals) y opcionalmente currentPage.
%>
<% const page = typeof currentPage !== 'undefined' ? currentPage : ''; %>
<% const admin = typeof esAdmin !== 'undefined' && esAdmin; %>
<%
  const isVentas = ['pedidos', 'presupuestos-vs-ventas', 'comisiones'].includes(page);
  const isCartera = ['clientes', 'contactos', 'agenda'].includes(page);
  const isCatalogo = page === 'articulos';
  const isRed = ['cooperativas', 'grupos-compras', 'clientes-cooperativas', 'clientes-grupos-compras', 'especialidades'].includes(page);
  const isAdminSection = ['comerciales', 'formas-pago', 'endpoints'].includes(page);
%>
<nav class="sidebar-nav p-3" id="sidebarNav" data-current-groups="<%= [isVentas && 'ventas', isCartera && 'cartera', isCatalogo && 'catalogo', isRed && 'red', isAdminSection && 'admin'].filter(Boolean).join(',') %>">
    <ul class="nav flex-column">
        <li class="nav-item mb-1">
            <a class="nav-link <%= !page || page === 'dashboard' ? 'active' : '' %>" href="/dashboard">
                <i class="fas fa-tachometer-alt me-2"></i>Dashboard
            </a>
        </li>

        <li class="nav-group" data-nav-group="ventas">
            <button type="button"
                    class="nav-group-toggle<%= isVentas ? ' is-current' : '' %>"
                    data-bs-toggle="collapse"
                    data-bs-target="#navGroupVentas"
                    aria-expanded="<%= isVentas ? 'true' : 'false' %>"
                    aria-controls="navGroupVentas">
                <span>Ventas</span>
                <i class="fas fa-chevron-down nav-group-chevron" aria-hidden="true"></i>
            </button>
            <div class="collapse<%= isVentas ? ' show' : '' %>" id="navGroupVentas">
                <ul class="nav flex-column nav-group-links">
                    <li class="nav-item">
                        <a class="nav-link <%= page === 'pedidos' ? 'active' : '' %>" href="/dashboard/pedidos">
                            <i class="fas fa-shopping-cart me-2"></i>Pedidos
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link <%= page === 'presupuestos-vs-ventas' ? 'active' : '' %>" href="/dashboard/presupuestos-vs-ventas">
                            <i class="fas fa-chart-line me-2"></i>Presupuestos vs Ventas
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link <%= page === 'comisiones' ? 'active' : '' %>" href="/dashboard/comisiones/comisiones">
                            <i class="fas fa-money-bill-wave me-2"></i>Mis Comisiones
                        </a>
                    </li>
                </ul>
            </div>
        </li>

        <li class="nav-group" data-nav-group="cartera">
            <button type="button"
                    class="nav-group-toggle<%= isCartera ? ' is-current' : '' %>"
                    data-bs-toggle="collapse"
                    data-bs-target="#navGroupCartera"
                    aria-expanded="<%= isCartera ? 'true' : 'false' %>"
                    aria-controls="navGroupCartera">
                <span>Cartera</span>
                <i class="fas fa-chevron-down nav-group-chevron" aria-hidden="true"></i>
            </button>
            <div class="collapse<%= isCartera ? ' show' : '' %>" id="navGroupCartera">
                <ul class="nav flex-column nav-group-links">
                    <li class="nav-item">
                        <a class="nav-link <%= page === 'clientes' ? 'active' : '' %>" href="/dashboard/clientes">
                            <i class="fas fa-users me-2"></i>Clientes
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link <%= page === 'contactos' ? 'active' : '' %>" href="/dashboard/contactos">
                            <i class="fas fa-address-book me-2"></i>Contactos
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link <%= page === 'agenda' ? 'active' : '' %>" href="/dashboard/agenda">
                            <i class="fas fa-calendar-check me-2"></i>Agenda
                        </a>
                    </li>
                </ul>
            </div>
        </li>

        <li class="nav-group" data-nav-group="catalogo">
            <button type="button"
                    class="nav-group-toggle<%= isCatalogo ? ' is-current' : '' %>"
                    data-bs-toggle="collapse"
                    data-bs-target="#navGroupCatalogo"
                    aria-expanded="<%= isCatalogo ? 'true' : 'false' %>"
                    aria-controls="navGroupCatalogo">
                <span>Catálogo</span>
                <i class="fas fa-chevron-down nav-group-chevron" aria-hidden="true"></i>
            </button>
            <div class="collapse<%= isCatalogo ? ' show' : '' %>" id="navGroupCatalogo">
                <ul class="nav flex-column nav-group-links">
                    <li class="nav-item">
                        <a class="nav-link <%= page === 'articulos' ? 'active' : '' %>" href="/dashboard/articulos">
                            <i class="fas fa-boxes me-2"></i>Artículos
                        </a>
                    </li>
                </ul>
            </div>
        </li>

        <li class="nav-group" data-nav-group="red">
            <button type="button"
                    class="nav-group-toggle<%= isRed ? ' is-current' : '' %>"
                    data-bs-toggle="collapse"
                    data-bs-target="#navGroupRed"
                    aria-expanded="<%= isRed ? 'true' : 'false' %>"
                    aria-controls="navGroupRed">
                <span>Red</span>
                <i class="fas fa-chevron-down nav-group-chevron" aria-hidden="true"></i>
            </button>
            <div class="collapse<%= isRed ? ' show' : '' %>" id="navGroupRed">
                <ul class="nav flex-column nav-group-links">
                    <li class="nav-item">
                        <a class="nav-link <%= page === 'cooperativas' ? 'active' : '' %>" href="/dashboard/cooperativas">
                            <i class="fas fa-handshake me-2"></i>Cooperativas
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link <%= page === 'grupos-compras' ? 'active' : '' %>" href="/dashboard/grupos-compras">
                            <i class="fas fa-users me-2"></i>Grupos Compra
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link <%= page === 'clientes-cooperativas' ? 'active' : '' %>" href="/dashboard/clientes-cooperativas">
                            <i class="fas fa-link me-2"></i>Clientes-Cooperativas
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link <%= page === 'clientes-grupos-compras' ? 'active' : '' %>" href="/dashboard/clientes-grupos-compras">
                            <i class="fas fa-link me-2"></i>Clientes-Grupos
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link <%= page === 'especialidades' ? 'active' : '' %>" href="/dashboard/especialidades">
                            <i class="fas fa-stethoscope me-2"></i>Especialidades
                        </a>
                    </li>
                </ul>
            </div>
        </li>

        <% if (admin) { %>
        <li class="nav-group" data-nav-group="admin">
            <button type="button"
                    class="nav-group-toggle<%= isAdminSection ? ' is-current' : '' %>"
                    data-bs-toggle="collapse"
                    data-bs-target="#navGroupAdmin"
                    aria-expanded="<%= isAdminSection ? 'true' : 'false' %>"
                    aria-controls="navGroupAdmin">
                <span>Administración</span>
                <i class="fas fa-chevron-down nav-group-chevron" aria-hidden="true"></i>
            </button>
            <div class="collapse<%= isAdminSection ? ' show' : '' %>" id="navGroupAdmin">
                <ul class="nav flex-column nav-group-links">
                    <li class="nav-item">
                        <a class="nav-link <%= page === 'comerciales' ? 'active' : '' %>" href="/dashboard/comerciales">
                            <i class="fas fa-user-tie me-2"></i>Comerciales
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link <%= page === 'formas-pago' ? 'active' : '' %>" href="/dashboard/formas-pago">
                            <i class="fas fa-credit-card me-2"></i>Formas de Pago
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link <%= page === 'endpoints' ? 'active' : '' %>" href="/dashboard/endpoints" target="_blank" rel="noopener noreferrer">
                            <i class="fas fa-file-code me-2"></i>Endpoints (Swagger)
                            <i class="fas fa-external-link-alt ms-1" style="font-size: 0.7rem;"></i>
                        </a>
                    </li>
                </ul>
            </div>
        </li>
        <% } %>
    </ul>
</nav>
