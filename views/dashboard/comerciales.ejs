<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link href="/css/colors.css" rel="stylesheet">
    <link href="/css/dashboard.css" rel="stylesheet">
    <style>
        .table-container {
            max-height: 75vh;
            overflow: auto;
            border: 1px solid #dee2e6;
            border-radius: 0.75rem;
        }
        .table th {
            position: sticky;
            top: 0;
            background-color: #fff;
            z-index: 10;
            border-bottom: 2px solid #dee2e6;
        }
        .table td {
            padding: 0.75rem;
            vertical-align: middle;
        }
        .comercial-row:hover {
            background-color: rgba(11, 137, 27, 0.05);
        }
        #modalConfirmacionComercial .modal-content {
            border: 1px solid var(--farmadescaso-border, #e2e8e4);
            border-radius: var(--farmadescaso-radius, 10px);
            box-shadow: var(--farmadescaso-shadow-lg, 0 8px 24px rgba(26, 46, 34, 0.1));
            font-family: var(--farmadescaso-font, 'DM Sans', system-ui, sans-serif);
        }
        #modalConfirmacionComercial .modal-header {
            border-bottom: 1px solid var(--farmadescaso-border, #e2e8e4);
            background: #fff;
            padding: 1rem 1.15rem;
        }
        #modalConfirmacionComercial .modal-title {
            font-weight: 650;
            color: var(--farmadescaso-text-primary, #1a2e22);
            font-size: 1.05rem;
        }
        #modalConfirmacionComercial .modal-body {
            color: var(--farmadescaso-text-secondary, #64748b);
            padding: 1.15rem;
            font-size: 0.95rem;
        }
        #modalConfirmacionComercial .modal-footer {
            border-top: 1px solid var(--farmadescaso-border, #e2e8e4);
            background: #fff;
            padding: 0.85rem 1.15rem;
            gap: 0.5rem;
        }
    </style>

    <%- include('../partials/navbar-styles') %></head>
<body>
    <%- include('../partials/navbar-dashboard') %>

    <div class="container-fluid mt-4">
        <div class="row">
            <div class="col-12">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <h1 class="mb-0 text-primary"><i class="fas fa-user-tie me-1 text-primary"></i>Comerciales</h1>
                        <p class="text-muted mb-0">Gestiona los comerciales del sistema</p>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-primary text-white fs-6">Total: <%= Array.isArray(comerciales) ? comerciales.length : 0 %></span>
                        <a href="/dashboard/comerciales/nuevo" class="btn btn-success">
                            <i class="fas fa-plus me-1"></i>Nuevo Comercial
                        </a>
                    </div>
                </div>

                <% if (query && query.success === 'comercial_creado') { %>
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="fas fa-check-circle me-2"></i>Comercial creado correctamente.
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
                <% } %>
                <% if (query && query.success === 'comercial_actualizado') { %>
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="fas fa-check-circle me-2"></i>Comercial actualizado correctamente.
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
                <% } %>
                <% if (query && query.success === 'comercial_eliminado') { %>
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="fas fa-check-circle me-2"></i>Comercial eliminado correctamente.
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
                <% } %>
                <% if (query && query.success === 'comercial_activado') { %>
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="fas fa-check-circle me-2"></i>Comercial activado. Ya puede iniciar sesión.
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
                <% } %>
                <% if (query && query.success === 'comercial_desactivado') { %>
                <div class="alert alert-warning alert-dismissible fade show" role="alert">
                    <i class="fas fa-ban me-2"></i>Comercial desactivado. No podrá iniciar sesión ni usar el CRM.
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
                <% } %>
                <% if (error || (query && query.error)) { %>
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    <%= error || (typeof query.error === 'string' ? query.error : 'No se pudo completar la acción solicitada.') %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
                <% } %>

                <div class="table-container">
                    <table class="table table-hover">
                        <thead class="table-light">
                            <tr>
                                <th>ID</th>
                                <th>Nombre</th>
                                <th>Email</th>
                                <th>DNI</th>
                                <th>Rol</th>
                                <th>Estado</th>
                                <th>Móvil</th>
                                <th>Provincia</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% 
                            // Asegurar que comerciales sea un array
                            const comercialesList = Array.isArray(comerciales) ? comerciales : [];
                            %>
                            <% if (!comercialesList || comercialesList.length === 0) { %>
                            <tr>
                                <td colspan="9" class="text-center text-muted py-4">
                                    <i class="fas fa-inbox fa-2x mb-2"></i><br>
                                    No hay comerciales registrados
                                </td>
                            </tr>
                            <% } else { %>
                            <% comercialesList.forEach(function(comercial) { %>
                            <% 
                            let rollDisplay = 'Comercial';
                            if (comercial && comercial.Roll) {
                                try {
                                    let rollValue = comercial.Roll;
                                    if (typeof rollValue === 'string' && rollValue.trim().startsWith('[')) {
                                        const rollArray = JSON.parse(rollValue);
                                        if (Array.isArray(rollArray) && rollArray.length > 0) {
                                            rollDisplay = rollArray.join(', ');
                                        } else {
                                            rollDisplay = String(rollValue);
                                        }
                                    } else if (Array.isArray(rollValue) && rollValue.length > 0) {
                                        rollDisplay = rollValue.join(', ');
                                    } else {
                                        rollDisplay = String(rollValue);
                                    }
                                } catch (e) {
                                    rollDisplay = String(comercial.Roll || 'Comercial');
                                }
                            }
                            const activoRaw = comercial.Activo ?? comercial.activo;
                            const estaActivo = (activoRaw === undefined || activoRaw === null)
                                ? true
                                : (Number(activoRaw) === 1 || activoRaw === true || String(activoRaw) === '1');
                            const comercialId = comercial.id || comercial.Id;
                            %>
                            <tr class="comercial-row<%= estaActivo ? '' : ' table-secondary' %>">
                                <td><%= comercialId %></td>
                                <td><strong><%= comercial.Nombre || comercial.nombre %></strong></td>
                                <td><%= comercial.Email || comercial.email %></td>
                                <td><%= comercial.DNI || comercial.dni || '-' %></td>
                                <td><span class="badge bg-info"><%= rollDisplay %></span></td>
                                <td>
                                    <% if (estaActivo) { %>
                                    <span class="badge bg-success">Activo</span>
                                    <% } else { %>
                                    <span class="badge bg-secondary">Inactivo</span>
                                    <% } %>
                                </td>
                                <td><%= comercial.Movil || comercial.movil || '-' %></td>
                                <td><%= comercial.nombreProvincia || '-' %></td>
                                <td class="text-center">
                                    <div class="btn-group" role="group">
                                        <a class="btn btn-sm btn-outline-primary" title="Ver" href="/dashboard/comerciales/<%= comercialId %>">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a class="btn btn-sm btn-outline-warning" title="Editar" href="/dashboard/comerciales/<%= comercialId %>/editar">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <button type="button"
                                                class="btn btn-sm <%= estaActivo ? 'btn-outline-success' : 'btn-outline-secondary' %> btn-confirm-action"
                                                title="<%= estaActivo ? 'Desactivar' : 'Activar' %>"
                                                data-action-url="/dashboard/comerciales/<%= comercialId %>/toggle-activo"
                                                data-action-title="<%= estaActivo ? 'Desactivar comercial' : 'Activar comercial' %>"
                                                data-action-message="<%= estaActivo ? '¿Desactivar este comercial? No podrá iniciar sesión ni usar el CRM.' : '¿Activar este comercial? Podrá iniciar sesión y usar el CRM.' %>"
                                                data-confirm-class="<%= estaActivo ? 'btn-warning' : 'btn-success' %>">
                                            <i class="fas <%= estaActivo ? 'fa-toggle-on' : 'fa-toggle-off' %>"></i>
                                        </button>
                                        <button type="button"
                                                class="btn btn-sm btn-outline-danger btn-confirm-action"
                                                title="Eliminar"
                                                data-action-url="/dashboard/comerciales/<%= comercialId %>/eliminar"
                                                data-action-title="Eliminar comercial"
                                                data-action-message="¿Estás seguro de eliminar este comercial? Esta acción no se puede deshacer."
                                                data-confirm-class="btn-danger">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                            <% }); %>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal confirmación (activar / desactivar / eliminar) -->
    <div class="modal fade" id="modalConfirmacionComercial" tabindex="-1" aria-labelledby="modalConfirmacionComercialLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalConfirmacionComercialLabel">
                        <i class="fas fa-exclamation-circle me-2 text-primary"></i>
                        <span id="modalConfirmacionTitulo">Confirmar</span>
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-0" id="modalConfirmacionMensaje"></p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-primary" id="modalConfirmacionAceptar">Aceptar</button>
                </div>
            </div>
        </div>
    </div>

    <form id="formConfirmacionComercial" method="POST" class="d-none" aria-hidden="true"></form>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/go-to-top.js"></script>
    <script>
      (function () {
        const modalEl = document.getElementById('modalConfirmacionComercial');
        const formEl = document.getElementById('formConfirmacionComercial');
        const titleEl = document.getElementById('modalConfirmacionTitulo');
        const msgEl = document.getElementById('modalConfirmacionMensaje');
        const acceptBtn = document.getElementById('modalConfirmacionAceptar');
        if (!modalEl || !formEl || !acceptBtn) return;

        const modal = new bootstrap.Modal(modalEl);

        document.querySelectorAll('.btn-confirm-action').forEach((btn) => {
          btn.addEventListener('click', function () {
            const url = btn.getAttribute('data-action-url');
            const title = btn.getAttribute('data-action-title') || 'Confirmar';
            const message = btn.getAttribute('data-action-message') || '¿Confirmas esta acción?';
            const confirmClass = btn.getAttribute('data-confirm-class') || 'btn-primary';

            formEl.setAttribute('action', url);
            titleEl.textContent = title;
            msgEl.textContent = message;

            acceptBtn.className = 'btn ' + confirmClass;
            acceptBtn.textContent = 'Aceptar';
            modal.show();
          });
        });

        acceptBtn.addEventListener('click', function () {
          if (!formEl.getAttribute('action')) return;
          formEl.submit();
        });
      })();
    </script>

    <!-- Go to Top Button -->
    <button id="goToTop" class="go-to-top" title="Ir arriba">
        <i class="fas fa-arrow-up"></i>
    </button>
</body>
</html>

